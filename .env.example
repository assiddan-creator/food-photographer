# Required for the live generate path (upload + Fal subscribe via /api/fal/proxy)
FAL_KEY=

# Required for photo QA ("התמונה בסדר" / "צלם שוב") and optional "נתח את המנה"
GEMINI_API_KEY=

# Optional. Vision model for photo QA + dish analysis.
# Default: gemini-3-flash-preview (falls back to gemini-2.5-flash if unavailable)
GEMINI_ANALYZE_MODEL=

# Optional. Fallback restaurant WhatsApp for customer templates (owner can override in «הגדרות מסעדה»).
# Phone digits (e.g. 972501234567) or a full https://wa.me/... URL.
NEXT_PUBLIC_WHATSAPP=

# Optional. Fallback Google Maps / Business review link for the "דירוג בגוגל" template.
# Owner can override in «הגדרות מסעדה». The Google template is request + link only — never a discount.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
